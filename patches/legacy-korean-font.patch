+
+namespace {
+class Korean_font {
+public:
+	bool is_pair(const char* text, int remaining) {
+		if (!legacy_korean_font_enabled || remaining < 2) {
+			return false;
+		}
+		const auto first = static_cast<unsigned char>(text[0]);
+		static bool reported_utf8 = false;
+		if (!reported_utf8 && first >= 0xe0 && first <= 0xef) {
+			reported_utf8 = true;
+			std::cerr << "Korean diagnostic: UTF-8-like lead encountered; renderer expects EUC-KR" << std::endl;
+		}
+		if (first < 0xb0 || first > 0xc8) return false;
+		load();
+		if (!loaded) {
+			return false;
+		}
+		const auto lead = static_cast<unsigned char>(text[0]);
+		const auto trail = static_cast<unsigned char>(text[1]);
+		return lead >= 0xb0 && lead <= 0xc8 && trail >= 0xa1 && trail <= 0xfe;
+	}
+	int width() const { return glyph_width; }
+	int height() const { return glyph_height; }
+	void paint(Image_buffer8* win, int x, int y, const char* text, unsigned char* trans) {
+		static bool reported_paint = false;
+		if (!reported_paint) {
+			reported_paint = true;
+			std::cerr << "Korean diagnostic: bitmap painting reached" << std::endl;
+		}
+		const auto lead = static_cast<unsigned char>(text[0]);
+		const auto trail = static_cast<unsigned char>(text[1]);
+		const auto index = (lead - 0xb0) * 94 + (trail - 0xa1);
+		const auto* glyph = glyphs.data() + index * bytes_per_glyph;
+		const unsigned char colour = trans ? trans[255] : 255;
+		for (int row = 0; row < glyph_height; ++row) {
+			for (int col = 0; col < glyph_width; ++col) {
+				if (glyph[row * bytes_per_row + col / 8] & (0x80 >> (col % 8))) {
+					win->put_pixel8(colour, x + col, y + row);
+				}
+			}
+		}
+	}
+private:
+	static constexpr int glyph_count = 25 * 94;
+	unsigned generation = static_cast<unsigned>(-1);
+	bool attempted = false;
+	bool loaded = false;
+	int glyph_width = 0;
+	int glyph_height = 0;
+	int bytes_per_row = 0;
+	int bytes_per_glyph = 0;
+	std::vector<unsigned char> glyphs;
+	bool load_file(const char* path) {
+		std::cerr << "Korean font probe: " << get_system_path(path) << std::endl;
+		if (!U7exists(path)) { std::cerr << "Korean font: missing" << std::endl; return false; }
+		IFileDataSource data(path);
+		if (!data.good() || data.getSize() < 4) {
+			std::cerr << "Korean font: unreadable/short header at " << path << std::endl;
+			return false;
+		}
+		std::cerr << "Korean font: file bytes=" << data.getSize() << std::endl;
+		data.skip(2);
+		glyph_width = data.read1();
+		glyph_height = data.read1();
+		if (glyph_width <= 0 || glyph_width > 32 || glyph_height <= 0 || glyph_height > 32) {
+			std::cerr << "Korean font: unsupported dimensions at " << path << std::endl;
+			return false;
+		}
+		bytes_per_row = (glyph_width + 7) / 8;
+		bytes_per_glyph = bytes_per_row * glyph_height;
+		std::cerr << "Korean font: header dimensions=" << glyph_width << "x" << glyph_height << std::endl;
+		const size_t expected = static_cast<size_t>(glyph_count) * bytes_per_glyph;
+		if (data.getAvail() != expected) {
+			std::cerr << "Korean font: expected " << expected << " bitmap bytes, got "
+			          << data.getAvail() << " at " << path << std::endl;
+			return false;
+		}
+		glyphs.resize(expected);
+		data.read(glyphs.data(), glyphs.size());
+		if (!data.good()) return false;
+		bool ink = false;
+		for (auto byte : glyphs) ink = ink || byte != 0;
+		if (!ink) {
+			std::cerr << "Korean font: empty bitmap at " << path << std::endl;
+			return false;
+		}
+		std::cerr << "Korean font: loaded " << path << " (" << glyph_width << "x"
+		          << glyph_height << ", EUC-KR 2350 glyphs)" << std::endl;
+		return true;
+	}
+	void load() {
+		if (generation != korean_font_generation) {
+			generation = korean_font_generation;
+			attempted = loaded = false;
+			glyphs.clear();
+		}
+		if (attempted) return;
+		attempted = true;
+		const char* paths[] = {PATCH_KOREAN_FONT, STATIC_KOREAN_FONT, KOREAN_FONT};
+		for (const char* path : paths) {
+			if (load_file(path)) { loaded = true; return; }
+		}
+		std::cerr << "Korean font: no valid korean.fnt in PATCH, STATIC or DATA" << std::endl;
+	}
+};
+Korean_font korean_font;
+}
+static void probe_korean_font() {
+	std::cerr << "Korean diagnostic: enabled=" << legacy_korean_font_enabled << std::endl;
+	korean_font.is_pair("\xb0\xa1", 2);
+}
 
